# 复制为 .env 后填写(server/.env 已被 .gitignore 排除)
# 或直接在设置页保存密钥(存本机 state.db,环境变量优先)

# 本地服务端口(默认 8080)
VRADIO_PORT=8080

# 网易云 API 容器地址(NeteaseCloudMusicApi,Docker :3000)
NETEASE_BASE=http://localhost:3000

# 网易云登录 Cookie(可选):登录 music.163.com 后从浏览器导出(取 MUSIC_U=… 一段即可)。
# 配置后 VIP/会员歌曲可完整播放;不配置则自动匿名注册,会员歌仅 30 秒试听(界面会如实标注)。
# 也可在前端设置页保存(验证后写入本机 state.db);环境变量优先于设置页保存的值。
# NETEASE_COOKIE=MUSIC_U=xxxxxxx;

# Fish Audio TTS —— https://fish.audio 注册获取 API Key
FISH_API_KEY=

# OpenWeather —— https://openweathermap.org 注册获取
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Shanghai

# Feishu / Lark 开放平台日历(未配置时日程注入降级)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
